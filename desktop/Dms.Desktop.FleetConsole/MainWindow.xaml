<Window x:Class="Dms.Desktop.FleetConsole.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AwakeDrive — Fleet Console"
        Height="650" Width="950"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Login panel -->
        <StackPanel Grid.Row="0" Grid.RowSpan="2"
                    Visibility="{Binding IsAuthenticated, Converter={StaticResource InverseBoolToVisibility}}"
                    MaxWidth="320" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="AwakeDrive Fleet Console" FontSize="20" FontWeight="Bold" Margin="0,0,0,4" />
            <TextBlock Text="Sign in as a Fleet Manager or Admin." Foreground="Gray" Margin="0,0,0,16" />

            <TextBlock Text="Email" />
            <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8" Padding="4" />

            <TextBlock Text="Password" />
            <PasswordBox x:Name="PasswordBox" Margin="0,2,0,8" Padding="4"
                         PasswordChanged="PasswordBox_PasswordChanged" />

            <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" TextWrapping="Wrap" Margin="0,0,0,8"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource NullOrEmptyToVisibility}}" />

            <Button Content="Sign in" Command="{Binding LoginCommand}" Padding="8,6"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
        </StackPanel>

        <!-- Dashboard -->
        <Grid Grid.Row="0" Grid.RowSpan="2"
              Visibility="{Binding IsAuthenticated, Converter={StaticResource BoolToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,12">
                <TextBlock Text="Live Incidents" FontSize="20" FontWeight="Bold" DockPanel.Dock="Left" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <TextBlock Text="{Binding HubStatus, StringFormat='Hub: {0}'}" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="Gray" />
                    <Button Content="Refresh" Command="{Binding RefreshCommand}" Padding="8,4" Margin="0,0,8,0" />
                    <Button Content="Sign out" Command="{Binding SignOutCommand}" Padding="8,4" />
                </StackPanel>
            </DockPanel>

            <TextBlock Grid.Row="0" Text="{Binding ErrorMessage}" Foreground="Red" TextWrapping="Wrap"
                       Margin="0,32,0,0" VerticalAlignment="Bottom"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource NullOrEmptyToVisibility}}" />

            <DataGrid Grid.Row="1" ItemsSource="{Binding Incidents}" AutoGenerateColumns="False"
                      IsReadOnly="True" CanUserAddRows="False" GridLinesVisibility="Horizontal">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Time (UTC)" Binding="{Binding TimestampUtc, StringFormat='u'}" Width="180" />
                    <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="140" />
                    <DataGridTextColumn Header="Driver" Binding="{Binding DriverName}" Width="160" />
                    <DataGridTextColumn Header="EAR" Binding="{Binding Ear, StringFormat='F2'}" Width="70" />
                    <DataGridTextColumn Header="MAR" Binding="{Binding Mar, StringFormat='F2'}" Width="70" />
                    <DataGridTextColumn Header="PERCLOS" Binding="{Binding Perclos, StringFormat='P0'}" Width="90" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</Window>
