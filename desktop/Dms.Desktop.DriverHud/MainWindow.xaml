<Window x:Class="Dms.Desktop.DriverHud.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AwakeDrive — Driver HUD"
        Height="720" Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="#111318">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Login panel -->
        <StackPanel Grid.Row="0" Grid.RowSpan="2"
                    Visibility="{Binding IsAuthenticated, Converter={StaticResource InverseBoolToVisibility}}"
                    MaxWidth="320" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="AwakeDrive Driver HUD" FontSize="20" FontWeight="Bold" Foreground="White" Margin="0,0,0,4" />
            <TextBlock Text="Sign in with your driver account." Foreground="Gray" Margin="0,0,0,16" />

            <TextBlock Text="Email" Foreground="White" />
            <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8" Padding="4" />

            <TextBlock Text="Password" Foreground="White" />
            <PasswordBox x:Name="PasswordBox" Margin="0,2,0,8" Padding="4"
                         PasswordChanged="PasswordBox_PasswordChanged" />

            <TextBlock Text="{Binding ErrorMessage}" Foreground="#FF6B6B" TextWrapping="Wrap" Margin="0,0,0,8"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource NullOrEmptyToVisibility}}" />

            <Button Content="Sign in" Command="{Binding LoginCommand}" Padding="8,6"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
        </StackPanel>

        <!-- HUD -->
        <Grid Grid.Row="0" Grid.RowSpan="2"
              Visibility="{Binding IsAuthenticated, Converter={StaticResource BoolToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,12">
                <TextBlock Text="Driver HUD" FontSize="20" FontWeight="Bold" Foreground="White" DockPanel.Dock="Left" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding DisplayName}" Foreground="White" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <TextBlock Text="{Binding PendingQueueCount, StringFormat='Queued: {0}'}" Foreground="Gray" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <Button Content="Simulate Incident" Command="{Binding SimulateIncidentCommand}" Padding="8,4" Margin="0,0,8,0" />
                    <Button Content="Sign out" Command="{Binding SignOutCommand}" Padding="8,4" />
                </StackPanel>
            </DockPanel>

            <!-- Camera preview -->
            <Border Grid.Row="1" Grid.Column="0" Background="Black" CornerRadius="4" Margin="0,0,12,0"
                    BorderThickness="3"
                    BorderBrush="{Binding IsAlerting, Converter={StaticResource AlertBorderBrush}}">
                <Grid>
                    <Image Source="{Binding PreviewFrame}" Stretch="Uniform" />
                    <TextBlock Text="{Binding CameraStatus}" Foreground="White" Background="#AA000000"
                               Padding="8" VerticalAlignment="Bottom" TextWrapping="Wrap"
                               Visibility="{Binding PreviewFrame, Converter={StaticResource NullToVisibility}}" />
                </Grid>
            </Border>

            <!-- Gauges -->
            <StackPanel Grid.Row="1" Grid.Column="1">
                <Border Background="#1B1E26" CornerRadius="4" Padding="12" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="Perception Engine" Foreground="Gray" FontSize="12" Margin="0,0,0,4" />
                        <TextBlock Text="{Binding EngineStatusMessage}" Foreground="#4CAF50" TextWrapping="Wrap" FontSize="12" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>

                <Border Background="#1B1E26" CornerRadius="4" Padding="12" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="EAR" Foreground="Gray" FontSize="12" />
                        <TextBlock Text="{Binding Ear, StringFormat='F2', FallbackValue='—'}" Foreground="White" FontSize="28" FontWeight="Bold" />
                    </StackPanel>
                </Border>

                <Border Background="#1B1E26" CornerRadius="4" Padding="12" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="MAR" Foreground="Gray" FontSize="12" />
                        <TextBlock Text="{Binding Mar, StringFormat='F2', FallbackValue='—'}" Foreground="White" FontSize="28" FontWeight="Bold" />
                    </StackPanel>
                </Border>

                <Border Background="#1B1E26" CornerRadius="4" Padding="12">
                    <StackPanel>
                        <TextBlock Text="PERCLOS" Foreground="Gray" FontSize="12" />
                        <TextBlock Text="{Binding Perclos, StringFormat='P0', FallbackValue='—'}" Foreground="White" FontSize="28" FontWeight="Bold" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Alert banner -->
            <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Background="#C0392B" CornerRadius="4"
                    Padding="12" Margin="0,12,0,0"
                    Visibility="{Binding IsAlerting, Converter={StaticResource BoolToVisibility}}">
                <DockPanel>
                    <TextBlock Text="{Binding AlertMessage}" Foreground="White" FontWeight="Bold" DockPanel.Dock="Left" VerticalAlignment="Center" />
                    <Button Content="Dismiss" Command="{Binding DismissAlertCommand}" DockPanel.Dock="Right"
                            HorizontalAlignment="Right" Padding="8,4" />
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
