@page "/"
@inject DmsApiClient Api
@inject AuthSession AuthSession
@inject DrowsinessHubClient Hub
@inject NavigationManager Nav
@implements IAsyncDisposable

<PageTitle>Dashboard — AwakeDrive</PageTitle>

@if (!AuthSession.IsAuthenticated)
{
    <p>Redirecting to sign-in…</p>
}
else
{
    <h1>Live Incidents</h1>
    <p>
        Hub: <span class="badge bg-@(_hubConnected ? "success" : "secondary")">@(_hubConnected ? "Connected" : "Connecting…")</span>
        — new incidents appear at the top automatically.
    </p>

    @if (_loadError is not null)
    {
        <div class="alert alert-danger">@_loadError</div>
    }
    else if (_incidents is null)
    {
        <p><em>Loading…</em></p>
    }
    else if (_incidents.Count == 0)
    {
        <p><em>No incidents recorded yet.</em></p>
    }
    else
    {
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>Time (UTC)</th>
                    <th>Type</th>
                    <th>Driver</th>
                    <th>EAR</th>
                    <th>MAR</th>
                    <th>PERCLOS</th>
                    <th>Location</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var incident in _incidents)
                {
                    <tr class="@(IsRecent(incident) ? "table-warning" : "")">
                        <td>@incident.TimestampUtc.ToString("u")</td>
                        <td>@incident.Type</td>
                        <td>@incident.DriverName</td>
                        <td>@(incident.Ear?.ToString("F2") ?? "—")</td>
                        <td>@(incident.Mar?.ToString("F2") ?? "—")</td>
                        <td>@(incident.Perclos?.ToString("P0") ?? "—")</td>
                        <td>@(incident.Location is { } loc ? $"{loc.Latitude:F4}, {loc.Longitude:F4}" : "—")</td>
                    </tr>
                }
            </tbody>
        </table>
    }
}

@code {
    private List<IncidentSummary>? _incidents;
    private string? _loadError;
    private bool _hubConnected;
    private DateTimeOffset _pageLoadedAtUtc;

    protected override async Task OnInitializedAsync()
    {
        if (!AuthSession.IsAuthenticated)
        {
            Nav.NavigateTo("/login");
            return;
        }

        _pageLoadedAtUtc = DateTimeOffset.UtcNow;

        try
        {
            _incidents = await Api.GetRecentIncidentsAsync(take: 100);
        }
        catch (DmsApiException ex)
        {
            _loadError = $"Could not load incidents: {ex.Message}";
            _incidents = [];
        }

        Hub.AlertReceived += OnAlertReceived;
        Hub.StateChanged += OnHubStateChanged;
        try
        {
            await Hub.StartAsync();
        }
        catch
        {
            // Dashboard still works from the initial GetRecentIncidentsAsync load
            // even if the live hub connection fails (e.g. Dms.Api not running).
        }
    }

    private void OnAlertReceived(DrowsinessAlert alert)
    {
        _incidents?.Insert(0, new IncidentSummary(
            alert.IncidentId, alert.DeviceId, alert.DriverId, alert.DriverName,
            alert.Type, alert.TimestampUtc, alert.Location, null, null, null, null));
        InvokeAsync(StateHasChanged);
    }

    private void OnHubStateChanged(Microsoft.AspNetCore.SignalR.Client.HubConnectionState state)
    {
        _hubConnected = state == Microsoft.AspNetCore.SignalR.Client.HubConnectionState.Connected;
        InvokeAsync(StateHasChanged);
    }

    private bool IsRecent(IncidentSummary incident) => incident.TimestampUtc >= _pageLoadedAtUtc;

    public async ValueTask DisposeAsync()
    {
        Hub.AlertReceived -= OnAlertReceived;
        Hub.StateChanged -= OnHubStateChanged;
        await Hub.StopAsync();
    }
}
